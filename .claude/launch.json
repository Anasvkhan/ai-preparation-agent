{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--reload", "--app-dir", "backend", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "worker",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && exec .venv/bin/python -m worker.main"],
      "port": 8001
    }
  ]
}

# ---- App ----
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
QUOTA_BYTES=104857600

# ---- MongoDB Atlas ----
MONGODB_URI=
MONGODB_DB=viva_agent

# ---- Object storage (S3-compatible: Supabase Storage / AWS S3 / MinIO) ----
STORAGE_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=viva-artifacts
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---- LLM ----
# mock = fake fixed answers, replay = real Gemini once then cached in fixtures/, gemini = always real
LLM_PROVIDER=replay
# IPv6 to Google is unreliable on some networks; true = use IPv4
GEMINI_FORCE_IPV4=true
GEMINI_API_KEY=
LLM_MODEL_CHAIN=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite
LLM_REPLAY_DIR=fixtures/llm

# ---- Embeddings ----
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
